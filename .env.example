# MongoDB Connection Strings
# You can provide multiple URIs separated by commas or newlines, or as a JSON array string.
# Example 1: Comma-separated
MONGODB_URIS=mongodb+srv://user1:pass1@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority,mongodb+srv://user2:pass2@cluster1.fghij.mongodb.net/?retryWrites=true&w=majority

# Example 2: Individual environment variables (also auto-detected)
# MONGODB_URI_CLUSTER_A=mongodb+srv://user1:pass1@cluster0.abcde.mongodb.net
# MONGODB_URI_CLUSTER_B=mongodb+srv://user2:pass2@cluster1.fghij.mongodb.net

# Optional Custom Database and Collection Names
MONGODB_DB_NAME=keepalive_db
MONGODB_COLLECTION_NAME=keepalive_status

# Discord Webhook Notification URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
